{
  "uid": "juniauto-weights",
  "title": "JuniAuto Weights & Rebalance",
  "tags": ["juniauto", "weights"],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "editable": true,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Portfolio construction",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Concentration HHI",
      "description": "Herfindahl-Hirschman index of target weights. See docs/knowledge-base/part4-gateway-execution.md §2.30.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 1},
      "interval": "",
      "targets": [
        {"expr": "juniauto_concentration_hhi", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 0.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.15},
              {"color": "red",    "value": 0.30}
            ]
          },
          "decimals": 3
        }
      },
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Portfolio turnover (Σ|Δw| per cycle)",
      "description": "Sum of absolute weight deltas across all names each cycle. Alert fires above 0.5.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 1},
      "interval": "",
      "targets": [
        {"expr": "juniauto_portfolio_turnover_ratio", "refId": "A", "legendFormat": "turnover"}
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red",   "value": 0.5}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cash weight (last cycle)",
      "description": "1 minus Σ target_weight over all executed candidates.",
      "datasource": {"type": "postgres", "uid": "QuestDB"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "interval": "",
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 1.0 - SUM(target_weight) AS cash_weight\n  FROM gateway_actions\n WHERE ts = (SELECT max(ts) FROM gateway_actions) AND executed = true"
        }
      ],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "value",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.30},
              {"color": "orange", "value": 0.60}
            ]
          }
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Live vs baseline (shadow)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Shadow EV delta bps (Kelly - fixed 5%)",
      "description": "Cycle-level pre-cost weighted-edge improvement of Kelly vs fixed-5% baseline. Positive = Kelly captures more edge.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "interval": "",
      "targets": [
        {"expr": "juniauto_shadow_ev_delta_bps", "refId": "A", "legendFormat": "EV_delta_bps"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Rotation rejects by reason (rate over 1h)",
      "description": "Reasons the reweight step failed to submit an order — PDT gate, submit error, missing quote.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "interval": "",
      "targets": [
        {
          "expr": "sum by (reason) (rate(juniauto_rotation_rejects_total[1h]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto"
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Per-symbol detail",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "collapsed": false
    },
    {
      "id": 6,
      "type": "table",
      "title": "Target vs current weight (latest cycle)",
      "description": "Symbol-level view of the last reweight decision. See docs/knowledge-base/part4-gateway-execution.md §2.28-2.30.",
      "datasource": {"type": "postgres", "uid": "QuestDB"},
      "gridPos": {"h": 12, "w": 14, "x": 0, "y": 19},
      "interval": "",
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol, rebalance_kind, target_weight, current_weight, delta_weight, net_edge_bps, total_cost_bps\n  FROM gateway_actions\n WHERE ts = (SELECT max(ts) FROM gateway_actions)\n ORDER BY target_weight DESC"
        }
      ],
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "target_weight"},   "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]},
          {"matcher": {"id": "byName", "options": "current_weight"},  "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]},
          {"matcher": {"id": "byName", "options": "delta_weight"},    "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]}
        ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Weight drift by symbol (bps)",
      "description": "Per-symbol (actual - target) weight in bps over time. Positive = overweight vs target.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 12, "w": 10, "x": 14, "y": 19},
      "interval": "",
      "targets": [
        {
          "expr": "juniauto_weight_drift_bps",
          "refId": "A",
          "legendFormat": "{{symbol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 0}
        }
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}}
    },
    {
      "id": 103,
      "type": "row",
      "title": "Top-K selector",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31},
      "collapsed": false
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Selected K (current)",
      "description": "Names in the top-K selector output this cycle. 0 when top-K gate is skipped (cold-start / CV below threshold).",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 32},
      "interval": "",
      "targets": [{"expr": "juniauto_selected_k", "refId": "A"}],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "value",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "green", "value": 5}
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Top-K active?",
      "description": "1 if the top-K gate fired this cycle (Bayesian trained AND CV >= threshold), 0 if skipped to uncapped Kelly.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 32},
      "interval": "",
      "targets": [{"expr": "juniauto_top_k_active", "refId": "A"}],
      "options": {
        "reduceOptions": {"values": false, "calcs": ["lastNotNull"]},
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "SKIPPED", "color": "orange"}, "1": {"text": "ACTIVE", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Edges CV vs activation threshold",
      "description": "Coefficient of variation of composite_edge across executed candidates. Top-K activates when this crosses the config threshold (sizing.top_k_activation_cv_threshold, default 0.05).",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 32},
      "interval": "",
      "targets": [{"expr": "juniauto_edges_cv", "refId": "A", "legendFormat": "cv"}],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "orange", "value": null},
              {"color": "green", "value": 0.05}
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Cumulative shadow EV delta (Kelly - fixed 5%)",
      "description": "Rolling sum of per-cycle Kelly-vs-baseline pre-cost edge deltas. Positive-and-growing = Kelly is capturing more edge over time. See docs/knowledge-base/part4-gateway-execution.md § promotion rule.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 32},
      "interval": "",
      "targets": [
        {"expr": "sum_over_time(juniauto_shadow_ev_delta_bps[24h])", "refId": "A", "legendFormat": "24h sum"},
        {"expr": "sum_over_time(juniauto_shadow_ev_delta_bps[7d])", "refId": "B", "legendFormat": "7d sum"}
      ],
      "fieldConfig": {
        "defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 0}}
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Concentration penalty (§2.30, observation-only)",
      "description": "Aggregate Grinold-Kahn concentration penalty from qe.concentration_penalty_bps over the post-Kelly weight vector, evaluated against sizing.aggregate_comfortable_weight (0.20). Rising values = the top-K is bunching weight more than the spec's comfortable threshold. Does NOT currently feed back into decisions — soft-enforcement follow-up will use this to shape edges. See docs/knowledge-base/part4-gateway-execution.md § 2.30.",
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 38},
      "interval": "",
      "targets": [
        {"expr": "juniauto_concentration_penalty_bps", "refId": "A", "legendFormat": "penalty bps"}
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 30}
            ]
          }
        }
      }
    },
    {
      "id": 104,
      "type": "row",
      "title": "Cadence validation (phantom cycles)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43},
      "collapsed": false
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Phantom basket forward return (bps) by cycle time",
      "description": "Kelly-weighted 1-day forward return of each phantom cycle's top-K basket. Compares 09:40 open, 12:30 midday, and 15:55 pre-close decisions. Higher = that time captures more edge. Verdict criterion needs ~40 trading days per the promotion rule (see docs/knowledge-base/part4-gateway-execution.md).",
      "datasource": {"type": "postgres", "uid": "QuestDB"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 44},
      "interval": "",
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time,\n       cycle_time AS metric,\n       SUM(target_weight * realized_return_bps) / NULLIF(SUM(target_weight), 0) AS value\n  FROM phantom_gateway_actions\n WHERE $__timeFilter(ts)\n   AND realized_return_bps IS NOT NULL\n   AND target_weight > 0\n GROUP BY ts, cycle_time\n ORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "lineWidth": 2, "pointSize": 5, "fillOpacity": 5},
          "unit": "short"
        }
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "Phantom cycle summary (rolling 30d)",
      "description": "Per-cycle-time summary of resolved phantom baskets. Sample count + mean basket return in bps.",
      "datasource": {"type": "postgres", "uid": "QuestDB"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 52},
      "interval": "",
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cycle_time,\n       COUNT(DISTINCT ts::date) AS trading_days,\n       AVG(basket_return) AS mean_return_bps,\n       STDDEV(basket_return) AS stddev_bps\n  FROM (\n    SELECT ts,\n           cycle_time,\n           SUM(target_weight * realized_return_bps) / NULLIF(SUM(target_weight), 0) AS basket_return\n      FROM phantom_gateway_actions\n     WHERE ts > dateadd('d', -30, now())\n       AND realized_return_bps IS NOT NULL\n       AND target_weight > 0\n     GROUP BY ts, cycle_time\n  )\n GROUP BY cycle_time\n ORDER BY cycle_time"
        }
      ],
      "options": {"showHeader": true}
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest top-K roster (from QuestDB)",
      "description": "Names selected by top-K this cycle with target weight, current weight, drift, and net edge. Ranked by target_weight.",
      "datasource": {"type": "postgres", "uid": "QuestDB"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 58},
      "interval": "",
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT symbol, target_weight, current_weight, delta_weight, net_edge_bps, total_cost_bps, rebalance_kind\n  FROM gateway_actions\n WHERE ts = (SELECT max(ts) FROM gateway_actions)\n   AND target_weight > 0\n ORDER BY target_weight DESC"
        }
      ],
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "target_weight"},  "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]},
          {"matcher": {"id": "byName", "options": "current_weight"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]},
          {"matcher": {"id": "byName", "options": "delta_weight"},   "properties": [{"id": "unit", "value": "percentunit"}, {"id": "decimals", "value": 4}]}
        ]
      }
    }
  ]
}
